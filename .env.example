# Copy to .env.local and fill with your real values.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini API key — get one at https://aistudio.google.com/apikey
#
# DEV: set this to call Gemini directly from the browser (fast iteration).
#      A VITE_ var is bundled into the client, so the key is publicly visible.
# PROD: LEAVE THIS UNSET. The app then calls the `ai-parse` Supabase Edge
#       Function instead, which holds the key server-side. Deploy that function
#       and set GEMINI_API_KEY as an Edge Function secret.
VITE_GEMINI_API_KEY=your-gemini-api-key
